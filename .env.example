# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Bot token from @BotFather.
BOT_TOKEN=123456789:AA-your-token-here

# Your own Telegram numeric id — everyone else is ignored.
# Get it from @userinfobot. Comma-separate to allow more than one.
ALLOWED_USER_ID=123456789

# ---------------------------------------------------------------------------
# Optional — sensible defaults, only set what you want to change
# ---------------------------------------------------------------------------

# Reply "This bot is private." to strangers (false = ignore them silently).
NOTIFY_UNAUTHORIZED=true

# Where settings.json (per-user default format) is stored.
# docker-compose overrides this to /data.
DATA_DIR=./data

# rembg model. u2net is the spec default; u2netp is lighter, isnet-general-use
# is sharper. Anything other than the baked-in u2net downloads on first start.
REMBG_MODEL=u2net

# Where rembg keeps its ONNX weights (docker-compose sets /models).
# U2NET_HOME=/models

# --- Look of the sticker ---------------------------------------------------

# Output canvas, in pixels. 512 is what Telegram wants for static stickers.
CANVAS_SIZE=512

# White outline thickness in final-canvas pixels (12 == MaxFilter(size=25)).
OUTLINE_RADIUS=12

# Gaussian blur on the outline mask; antialiases the stroke. 0 = hard edge.
OUTLINE_SOFTNESS=1.5

# Alpha above which a pixel counts as "subject" when cropping empty margins.
ALPHA_THRESHOLD=8

# Long side the upload is downscaled to before inference (u2net works at 320px
# internally, so this only bounds memory use).
MAX_INPUT_SIDE=2000

# --- Limits ----------------------------------------------------------------

# Telegram caps bot downloads at 20 MB.
MAX_UPLOAD_MB=20

# Telegram caps static stickers at 512 KB.
MAX_STICKER_KB=512

# Seconds allowed for one upload to Telegram. aiogram's own default is 60,
# which a slow or flaky uplink can exceed on a few hundred KB.
UPLOAD_TIMEOUT_SECONDS=180

# Images processed at the same time. Each job is one thread + one ONNX run.
MAX_CONCURRENT_JOBS=2

# How long a processed image stays available for the inline buttons, and how
# many results are kept in memory at once.
RESULT_TTL_SECONDS=900
RESULT_CACHE_SIZE=32

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Threads onnxruntime may use. Uncomment to stop it grabbing every core.
# OMP_NUM_THREADS=4
